#!/usr/bin/env python3
# fm-context-index - local semantic index over this firstmate home's
# conversational and operational context.
#
# Indexes Claude Code session transcripts for this home, data/*.md records,
# per-task briefs and scout reports, and state/*.status history into a
# DEDICATED local Qdrant instance, then answers semantic queries with
# provenance. Ingestion is incremental and idempotent: a chunk's point id is
# derived from its content hash, so re-running skips everything unchanged.
#
# Privacy boundary: nothing leaves this machine. Embeddings are computed by a
# local sentence-transformers model and stored in a firstmate-only collection on
# a firstmate-only Qdrant instance. The endpoint is loopback-only, and the
# script refuses to talk to the Qdrant ports another project's RAG serves
# (6333/6334); see docs/context-index.md.
#
# Instance boundary: every identity this tool uses - collection, container,
# volume, compose project, loopback port, and transcript glob - is derived from
# the resolved FM_HOME, so two firstmate homes on one machine never share a
# store by default. A collection also records the home that claimed it, and
# indexing or searching a collection claimed by a different home is refused
# rather than performed. Search additionally filters on the indexing home, so a
# collection that somehow holds two homes' records still answers with only this
# home's. Run `fm-context-index identity` to see the resolved values.
#
# Usage:
#   fm-context-index index [--dry-run] [--json] [--kind KIND]...
#   fm-context-index search QUERY [--k N] [--kind KIND]... [--json]
#   fm-context-index identity [--json|--env]
#   fm-context-index --help
#
# Environment:
#   FM_HOME                  firstmate home to index (default: the repo root)
#   FM_CONTEXT_INSTANCE      instance label (default: derived from FM_HOME)
#   FM_CONTEXT_QDRANT_URL    dedicated Qdrant base URL, loopback host only
#                            (default: derived port on 127.0.0.1)
#   FM_CONTEXT_COLLECTION    collection name (default: derived from FM_HOME)
#   FM_CONTEXT_TRANSCRIPTS   glob for Claude Code transcripts of this home
#   CLAUDE_CONFIG_DIR        Claude Code config dir the glob is derived under
#   FM_CONTEXT_MODEL         local sentence-transformers model id
#
# Setup, start/stop, and dependency notes: docs/context-index.md.
"""Local semantic context index for one firstmate home."""

from __future__ import annotations

import argparse
import datetime
import glob
import hashlib
import json
import os
import re
import sys
import urllib.error
import urllib.parse
import urllib.request
import uuid
from pathlib import Path

DEFAULT_MODEL = "sentence-transformers/all-MiniLM-L6-v2"

# Ports served by the application RAG instance this index must never touch.
FOREIGN_QDRANT_PORTS = (6333, 6334)

# The only hosts a store may live on. Everything indexed here - transcripts,
# captain records, briefs, scout reports - never leaves the device, so a stray
# environment variable must not be able to ship it to a remote host. A remote
# store would have to be a separate, deliberate decision.
LOOPBACK_HOSTS = ("127.0.0.1", "localhost", "::1")

# Loopback window every home's own instance is placed in. It sits clear of the
# conventional Qdrant ports above so a derived port can never land on one.
PORT_WINDOW_START = 6600
PORT_WINDOW_SIZE = 300

# Name stems each per-home identity is built on.
COLLECTION_STEM = "fm-context"
CONTAINER_STEM = "fm-context-qdrant"
VOLUME_STEM = "fm-context-qdrant-storage"

# The one command that starts this home's own instance, quoted in every
# operator-facing failure so a stopped store never reads as a missing index.
# The substitution is deliberately unquoted: the assignments are emitted one per
# line, so word-splitting them into arguments of env is exactly what is wanted.
START_COMMAND = ('env $(bin/fm-context-index identity --env) docker compose '
                 '-f docs/examples/fm-context-qdrant.compose.yml up -d')

# Deterministic namespace so a chunk's id depends only on its content hash.
POINT_NAMESPACE = uuid.UUID("6f0f5a2e-0a6d-5d61-9a0a-6d6f6e746578")

KINDS = ("transcript", "captain", "learning", "record", "report", "brief", "status")

TARGET_TOKENS = 750
OVERLAP_TOKENS = 100
MIN_CHUNK_CHARS = 40

EMBED_BATCH = 64
UPSERT_BATCH = 128
LOOKUP_BATCH = 256

# Transcript lines that carry harness plumbing rather than conversation.
NOISE_PREFIXES = (
    "<command-name>",
    "<command-message>",
    "<local-command-stdout>",
    "<bash-input>",
    "<bash-stdout>",
    "Caveat: The messages below",
)


class ContextIndexError(Exception):
    """One deterministic, operator-facing failure."""


class QdrantHTTPError(ContextIndexError):
    """One HTTP failure from this home's store, carrying its status code.

    The status is what callers decide on: a rendered message can contain the
    digits of any status by coincidence, and reading absence out of the text
    would turn a server error into an absent, unclaimed collection.
    """

    def __init__(self, message: str, status: int):
        super().__init__(message)
        self.status = status


# --- per-home instance identity --------------------------------------------


def home_fingerprint(home) -> str:
    """Stable digest of one resolved home path; the root of every identity."""
    return hashlib.sha256(str(home).encode("utf-8")).hexdigest()


def instance_slug(home) -> str:
    """Readable, stable per-home label: the home's folder plus a short digest.

    The folder name keeps the label recognisable while debugging, and the
    digest keeps two homes that end in the same folder name apart.
    """
    fingerprint = home_fingerprint(home)
    label = re.sub(r"[^a-z0-9]+", "-", Path(home).name.lower()).strip("-")
    return "%s-%s" % (label[:24] or "home", fingerprint[:8])


def instance_port(home) -> int:
    """Loopback port for this home's own instance, inside the reserved window."""
    return PORT_WINDOW_START + int(
        home_fingerprint(home)[8:16], 16) % PORT_WINDOW_SIZE


def transcript_glob(home) -> str:
    """Claude Code's transcript directory for this home, as a glob.

    Claude Code names a project's transcript directory after the absolute
    project path with every non-alphanumeric character replaced by a dash.
    CLAUDE_CONFIG_DIR relocates the enclosing config directory.
    """
    config = os.environ.get("CLAUDE_CONFIG_DIR") or str(Path.home() / ".claude")
    encoded = re.sub(r"[^A-Za-z0-9]", "-", str(home))
    return str(Path(config).expanduser() / "projects" / encoded / "*.jsonl")


class Instance:
    """Every identity one firstmate home uses for its own context store.

    Nothing here is a shared constant: an unconfigured second home derives a
    different collection, container, volume, compose project, and port, so it
    cannot read or write the first home's history by accident.
    """

    def __init__(self, home, url=None, collection=None, transcripts=None,
                 label=None):
        self.home = Path(home).expanduser().resolve()
        self.slug = label or instance_slug(self.home)
        self.port = instance_port(self.home)
        self.collection = collection or "%s-%s" % (COLLECTION_STEM, self.slug)
        self.container = "%s-%s" % (CONTAINER_STEM, self.slug)
        self.volume = "%s-%s" % (VOLUME_STEM, self.slug)
        self.compose_project = "%s-%s" % (COLLECTION_STEM, self.slug)
        self.transcripts = transcripts or transcript_glob(self.home)
        self.url = resolve_url(url or "http://127.0.0.1:%d" % self.port)
        endpoint_port = urllib.parse.urlsplit(self.url).port
        if endpoint_port is not None:
            self.port = endpoint_port

    def fields(self) -> dict:
        return {
            "instance": self.slug,
            "home": str(self.home),
            "url": self.url,
            "port": self.port,
            "collection": self.collection,
            "container": self.container,
            "volume": self.volume,
            "compose_project": self.compose_project,
            "transcripts": self.transcripts,
        }

    def environment(self) -> list:
        """Assignments the compose file needs, in `KEY=value` form.

        START_COMMAND word-splits these, so a value containing whitespace would
        silently become two arguments. The transcript glob, the one value that
        can realistically contain a space, is not published here: compose does
        not need it, and `identity` and `identity --json` still report it. The
        rest are space-free by construction, so the guard below only fires on an
        unusual explicit override, and it fails loudly rather than emitting a
        line that would word-split.
        """
        assignments = []
        for key, value in (
            ("FM_CONTEXT_COMPOSE_PROJECT", self.compose_project),
            ("FM_CONTEXT_CONTAINER", self.container),
            ("FM_CONTEXT_VOLUME", self.volume),
            ("FM_CONTEXT_PORT", self.port),
            ("FM_CONTEXT_QDRANT_URL", self.url),
            ("FM_CONTEXT_COLLECTION", self.collection),
        ):
            text = str(value)
            if any(character.isspace() for character in text):
                raise ContextIndexError(
                    "refusing to publish %s=%r: it contains whitespace, and the "
                    "documented start command word-splits these assignments. "
                    "Set %s to a value with no whitespace (docs/context-index.md)."
                    % (key, text, key))
            assignments.append("%s=%s" % (key, text))
        return assignments


def identity_point_id(collection: str) -> str:
    """Id of the marker point recording which home owns this collection."""
    return str(uuid.uuid5(POINT_NAMESPACE, "instance-identity:" + collection))


def check_store_identity(payload, home: str, collection: str, url: str) -> None:
    """Refuse a collection another firstmate home has already claimed.

    An unclaimed collection is not refused: it is claimed on the next index.
    """
    owner = (payload or {}).get("home")
    if not owner or owner == home:
        return
    raise ContextIndexError(
        "refusing collection %s at %s: it belongs to the firstmate home %s, "
        "not %s. Each home indexes into its own store; run "
        "'bin/fm-context-index identity' to see this home's own collection "
        "(docs/context-index.md)." % (collection, url, owner, home))


# --- text handling ---------------------------------------------------------


def estimate_tokens(text: str) -> int:
    """Approximate token count without pulling in a tokenizer dependency."""
    return max(1, (len(text) + 3) // 4)


def chunk_text(text: str, target_tokens: int = TARGET_TOKENS,
               overlap_tokens: int = OVERLAP_TOKENS) -> list:
    """Split text into overlapping chunks of roughly target_tokens each.

    Splitting happens on line boundaries so a chunk stays readable as a
    snippet. A single oversized line is emitted on its own rather than cut
    mid-word.
    """
    if target_tokens < 1:
        raise ContextIndexError("target_tokens must be positive")
    if overlap_tokens < 0 or overlap_tokens >= target_tokens:
        raise ContextIndexError("overlap_tokens must be >= 0 and < target_tokens")
    lines = text.splitlines()
    chunks = []
    current: list = []
    current_tokens = 0
    for line in lines:
        line_tokens = estimate_tokens(line)
        if current and current_tokens + line_tokens > target_tokens:
            chunks.append("\n".join(current).strip())
            carry: list = []
            carried = 0
            for prev in reversed(current):
                prev_tokens = estimate_tokens(prev)
                if carried + prev_tokens > overlap_tokens:
                    break
                carry.insert(0, prev)
                carried += prev_tokens
            current = carry
            current_tokens = carried
        current.append(line)
        current_tokens += line_tokens
    if current:
        chunks.append("\n".join(current).strip())
    return [c for c in chunks if len(c) >= MIN_CHUNK_CHARS]


def content_hash(kind: str, source: str, text: str, home: str = "") -> str:
    """Stable content hash for one chunk, including where it came from.

    The indexing home is part of the hash, so two homes never collapse onto
    one point id even if they are pointed at the same collection by hand.
    """
    digest = hashlib.sha256()
    digest.update(kind.encode("utf-8"))
    digest.update(b"\0")
    digest.update(source.encode("utf-8"))
    digest.update(b"\0")
    digest.update(home.encode("utf-8"))
    digest.update(b"\0")
    digest.update(text.encode("utf-8"))
    return digest.hexdigest()


def point_id(chunk_hash: str) -> str:
    """Deterministic Qdrant point id derived from the content hash."""
    return str(uuid.uuid5(POINT_NAMESPACE, chunk_hash))


def make_chunks(kind: str, source: str, text: str, **payload) -> list:
    """Build the payload records for one source document."""
    records = []
    for position, body in enumerate(chunk_text(text)):
        chunk_hash = content_hash(kind, source, body, str(payload.get("home") or ""))
        record = {
            "id": point_id(chunk_hash),
            "hash": chunk_hash,
            "kind": kind,
            "source": source,
            "chunk": position,
            "text": body,
        }
        for key, value in payload.items():
            if value is not None:
                record[key] = value
        records.append(record)
    return records


def select_new(records: list, existing_ids) -> tuple:
    """Split records into (new, already-indexed), deduplicating within the batch."""
    existing = set(existing_ids)
    new = []
    seen = set()
    skipped = 0
    for record in records:
        if record["id"] in existing or record["id"] in seen:
            skipped += 1
            continue
        seen.add(record["id"])
        new.append(record)
    return new, skipped


# --- sources ---------------------------------------------------------------


def _clean_text(value) -> str:
    if not isinstance(value, str):
        return ""
    text = re.sub(r"<system-reminder>.*?</system-reminder>", "", value, flags=re.DOTALL)
    text = text.strip()
    if not text:
        return ""
    for prefix in NOISE_PREFIXES:
        if text.startswith(prefix):
            return ""
    return text


def message_text(message) -> str:
    """Extract conversational text from one transcript message, skipping tool noise."""
    if not isinstance(message, dict):
        return ""
    content = message.get("content")
    if isinstance(content, str):
        return _clean_text(content)
    if not isinstance(content, list):
        return ""
    parts = []
    for block in content:
        if not isinstance(block, dict):
            continue
        if block.get("type") != "text":
            continue
        piece = _clean_text(block.get("text"))
        if piece:
            parts.append(piece)
    return "\n\n".join(parts)


def transcript_records(pattern: str, home) -> list:
    """Chunk the user and assistant turns of every matching transcript file."""
    records = []
    home = str(home)
    for path in sorted(glob.glob(os.path.expanduser(pattern))):
        session = Path(path).stem
        turns = []
        first_ts = None
        try:
            handle = open(path, "r", encoding="utf-8", errors="replace")
        except OSError:
            continue
        with handle:
            for line in handle:
                line = line.strip()
                if not line:
                    continue
                try:
                    entry = json.loads(line)
                except ValueError:
                    continue
                if not isinstance(entry, dict):
                    continue
                if entry.get("type") not in ("user", "assistant"):
                    continue
                text = message_text(entry.get("message"))
                if not text:
                    continue
                timestamp = entry.get("timestamp")
                if first_ts is None:
                    first_ts = timestamp
                role = entry.get("type")
                turns.append("%s: %s" % (role, text))
        if not turns:
            continue
        records.extend(make_chunks(
            "transcript",
            path,
            "\n\n".join(turns),
            home=home,
            session=session,
            timestamp=first_ts,
            role="conversation",
        ))
    return records


def _file_timestamp(path: Path):
    try:
        stamp = datetime.datetime.fromtimestamp(
            path.stat().st_mtime, tz=datetime.timezone.utc
        )
    except OSError:
        return None
    return stamp.strftime("%Y-%m-%dT%H:%M:%SZ")


def _read(path: Path) -> str:
    try:
        return path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return ""


def data_records(home: Path, kinds) -> list:
    """Chunk this home's durable records: captain prefs, learnings, registries."""
    records = []
    for path in sorted((home / "data").glob("*.md")):
        name = path.name
        if name in ("captain.md", "captain-shared.md"):
            kind = "captain"
        elif name == "learnings.md":
            kind = "learning"
        else:
            kind = "record"
        if kind not in kinds:
            continue
        text = _read(path)
        if not text.strip():
            continue
        records.extend(make_chunks(
            kind, str(path), text, home=str(home),
            timestamp=_file_timestamp(path), role="firstmate"))
    return records


def task_records(home: Path, kinds) -> list:
    """Chunk per-task scout reports and crewmate briefs."""
    records = []
    for name, kind in (("report.md", "report"), ("brief.md", "brief")):
        if kind not in kinds:
            continue
        for path in sorted((home / "data").glob("*/" + name)):
            text = _read(path)
            if not text.strip():
                continue
            records.extend(make_chunks(
                kind,
                str(path),
                text,
                home=str(home),
                task=path.parent.name,
                timestamp=_file_timestamp(path),
                role="crewmate" if kind == "report" else "firstmate",
            ))
    return records


def status_records(home: Path) -> list:
    """Chunk each task's status history as one document per task."""
    records = []
    for path in sorted((home / "state").glob("*.status")):
        text = _read(path)
        if not text.strip():
            continue
        records.extend(make_chunks(
            "status",
            str(path),
            text,
            home=str(home),
            task=path.name[: -len(".status")],
            timestamp=_file_timestamp(path),
            role="crewmate",
        ))
    return records


def warn(message: str) -> None:
    """One operator warning that does not fail the run."""
    sys.stderr.write("fm-context-index: warning: %s\n" % message)


def transcript_glob_warning(pattern: str):
    """Message for a transcript glob that matched nothing, or None.

    An index run that matched no transcripts must never read as a plain
    success, but it is not a failure either: a genuinely new home has no
    sessions recorded yet. The two causes are told apart by whether the
    directory the glob names exists at all.
    """
    expanded = os.path.expanduser(pattern)
    if glob.glob(expanded):
        return None
    parent = Path(expanded).parent
    if parent.is_dir():
        return ("no Claude Code transcripts matched %s. This home has no "
                "recorded sessions yet, which is expected on a first run; "
                "every other source was still indexed." % expanded)
    return ("no Claude Code transcripts matched %s, and its directory %s does "
            "not exist, so this home's transcript path is probably wrong: "
            "Claude Code never encoded this home path. Check whether FM_HOME is "
            "reached through a symlink, so the resolved path differs from the "
            "one Claude Code encoded, and whether CLAUDE_CONFIG_DIR differs for "
            "this shell. FM_CONTEXT_TRANSCRIPTS sets the glob outright, and "
            "CLAUDE_CONFIG_DIR relocates the directory it is derived under "
            "(docs/context-index.md)." % (expanded, parent))


def kind_counts(records: list, kinds) -> dict:
    """Chunks per requested kind, so a source that contributed nothing shows 0."""
    counts = {kind: 0 for kind in (kinds or KINDS)}
    for record in records:
        counts[record["kind"]] = counts.get(record["kind"], 0) + 1
    return counts


def format_counts(counts: dict) -> str:
    return ", ".join("%s=%d" % item for item in sorted(counts.items())) or "none"


def collect(home: Path, transcripts: str, kinds) -> list:
    """Gather every requested source kind into one record list.

    Warns, without failing, when transcripts were asked for and the glob
    matched nothing; a caller that excluded them with --kind hears nothing.
    """
    wanted = set(kinds) if kinds else set(KINDS)
    records = []
    if "transcript" in wanted:
        records.extend(transcript_records(transcripts, home))
        message = transcript_glob_warning(transcripts)
        if message:
            warn(message)
    records.extend(data_records(home, wanted))
    records.extend(task_records(home, wanted))
    if "status" in wanted:
        records.extend(status_records(home))
    return records


# --- dedicated Qdrant instance --------------------------------------------


def resolve_url(url: str) -> str:
    """Return the dedicated instance URL, refusing a store this tool must not use.

    Two independent refusals: a host that is not this machine, and the ports
    another project's Qdrant serves.
    """
    url = url.rstrip("/")
    parts = urllib.parse.urlsplit(url)
    host = (parts.hostname or "").lower()
    if host not in LOOPBACK_HOSTS:
        raise ContextIndexError(
            "refusing to use %s: host %s is not this machine. This index never "
            "leaves the device, so it only talks to %s (docs/context-index.md)."
            % (url, host or "(none)", ", ".join(LOOPBACK_HOSTS)))
    try:
        port = parts.port
    except ValueError:
        raise ContextIndexError("refusing to use %s: it has no valid port." % url)
    port = 6333 if port is None else port
    if port in FOREIGN_QDRANT_PORTS:
        raise ContextIndexError(
            "refusing to use %s: port %d belongs to the application's own Qdrant. "
            "firstmate uses its own instance (docs/context-index.md)." % (url, port))
    return url


def search_filter(home: str, kinds) -> dict:
    """Restrict a search to this home's records of the requested kinds.

    The home clause is not an optimisation: it is what keeps a collection that
    somehow holds two homes' records from answering with the other home's.
    The kind clause also excludes the instance marker point.
    """
    return {"must": [
        {"key": "home", "match": {"value": home}},
        {"key": "kind", "match": {"any": list(kinds) if kinds else list(KINDS)}},
    ]}


class Qdrant:
    """Minimal REST client for one home's own instance; no extra dependency."""

    def __init__(self, instance: Instance, timeout: float = 30.0):
        self.instance = instance
        self.url = instance.url
        self.collection = instance.collection
        self.home = str(instance.home)
        self.timeout = timeout

    def _call(self, method: str, path: str, body=None):
        data = None
        headers = {}
        if body is not None:
            data = json.dumps(body).encode("utf-8")
            headers["Content-Type"] = "application/json"
        request = urllib.request.Request(
            self.url + path, data=data, headers=headers, method=method)
        try:
            with urllib.request.urlopen(request, timeout=self.timeout) as response:
                return json.loads(response.read().decode("utf-8"))
        except urllib.error.HTTPError as error:
            detail = error.read().decode("utf-8", "replace")[:400]
            raise QdrantHTTPError(
                "qdrant %s %s failed: %s %s" % (method, path, error.code, detail),
                error.code)
        except urllib.error.URLError as error:
            raise ContextIndexError(
                "cannot reach this home's context index at %s (%s). "
                "Start it with: %s" % (self.url, error.reason, START_COMMAND))

    def has_collection(self) -> bool:
        try:
            self._call("GET", "/collections/%s" % self.collection)
            return True
        except QdrantHTTPError as error:
            if error.status != 404:
                raise
            return False

    def require_collection(self) -> None:
        """Say plainly that this home has no index yet, rather than 404ing."""
        if self.has_collection():
            return
        raise ContextIndexError(
            "no index for this home yet: collection %s does not exist at %s. "
            "Build it with: bin/fm-context-index index" % (self.collection, self.url))

    def ensure_collection(self, dim: int) -> None:
        if self.has_collection():
            return
        self._call("PUT", "/collections/%s" % self.collection, {
            "vectors": {"size": dim, "distance": "Cosine"},
        })

    def owner_marker(self):
        """Payload of an existing collection's owner marker, or None."""
        result = self._call("POST", "/collections/%s/points" % self.collection, {
            "ids": [identity_point_id(self.collection)],
            "with_payload": True, "with_vector": False,
        })
        points = result.get("result") or []
        return (points[0].get("payload") or {}) if points else None

    def require_own_collection(self) -> None:
        """Require an existing collection this home owns, without re-asking.

        The existence check the refusal message needs is made once, and the
        owner marker is then read straight from the collection it proved.
        """
        self.require_collection()
        check_store_identity(
            self.owner_marker(), self.home, self.collection, self.url)

    def claim_identity(self, dim: int) -> None:
        """Verify ownership, then record this home as the collection's owner.

        Only ever called once ensure_collection has proved the collection
        exists, so the marker is read directly rather than re-asking for it.
        """
        check_store_identity(
            self.owner_marker(), self.home, self.collection, self.url)
        vector = [1.0] + [0.0] * (dim - 1)
        self.upsert([{
            "id": identity_point_id(self.collection),
            "vector": vector,
            "payload": {
                "kind": "_instance",
                "home": self.home,
                "instance": self.instance.slug,
            },
        }])

    def existing_ids(self, ids) -> set:
        found = set()
        ids = list(ids)
        for start in range(0, len(ids), LOOKUP_BATCH):
            batch = ids[start:start + LOOKUP_BATCH]
            result = self._call("POST", "/collections/%s/points" % self.collection, {
                "ids": batch, "with_payload": False, "with_vector": False,
            })
            for point in result.get("result") or []:
                found.add(str(point.get("id")))
        return found

    def upsert(self, points) -> None:
        self._call("PUT", "/collections/%s/points?wait=true" % self.collection,
                   {"points": points})

    def search(self, vector, limit: int, kinds):
        body = {
            "vector": vector,
            "limit": limit,
            "with_payload": True,
            "filter": search_filter(self.home, kinds),
        }
        result = self._call(
            "POST", "/collections/%s/points/search" % self.collection, body)
        return result.get("result") or []


# --- local embedding model -------------------------------------------------


class Embedder:
    """Local sentence-transformers model; never a remote embedding service."""

    def __init__(self, model_id: str):
        try:
            from sentence_transformers import SentenceTransformer
        except ImportError:
            raise ContextIndexError(
                "sentence-transformers is not installed. Install it locally with: "
                "pip3 install sentence-transformers (docs/context-index.md)")
        self.model = SentenceTransformer(model_id)
        self.dim = int(self.model.get_sentence_embedding_dimension())

    def encode(self, texts) -> list:
        vectors = self.model.encode(
            list(texts), batch_size=EMBED_BATCH, show_progress_bar=False,
            normalize_embeddings=True)
        return [[float(value) for value in vector] for vector in vectors]


# --- commands --------------------------------------------------------------


def payload_of(record: dict) -> dict:
    return {key: value for key, value in record.items() if key != "id"}


def command_index(args) -> int:
    instance = resolve_instance(args)
    records = collect(instance.home, instance.transcripts, args.kind)
    counts = kind_counts(records, args.kind)
    if args.dry_run:
        if args.json:
            plan = {"chunks": records, "count": len(records),
                    "chunks_by_kind": counts}
            plan.update(instance.fields())
            json.dump(plan, sys.stdout, indent=2)
            sys.stdout.write("\n")
        else:
            print("planned: %d chunks (%s) for %s into %s at %s" % (
                len(records), format_counts(counts),
                instance.slug, instance.collection, instance.url))
        return 0

    client = Qdrant(instance)
    embedder = Embedder(args.model)
    client.ensure_collection(embedder.dim)
    client.claim_identity(embedder.dim)
    existing = client.existing_ids(record["id"] for record in records)
    new, skipped = select_new(records, existing)

    sources = set()
    for start in range(0, len(new), UPSERT_BATCH):
        batch = new[start:start + UPSERT_BATCH]
        vectors = embedder.encode(record["text"] for record in batch)
        client.upsert([
            {"id": record["id"], "vector": vector, "payload": payload_of(record)}
            for record, vector in zip(batch, vectors)
        ])
        sources.update(record["source"] for record in batch)

    summary = dict(instance.fields())
    summary.update({
        "chunks_seen": len(records),
        "chunks_new": len(new),
        "chunks_unchanged": skipped,
        "sources_written": len(sources),
        "chunks_by_kind": counts,
    })
    if args.json:
        json.dump(summary, sys.stdout, indent=2)
        sys.stdout.write("\n")
    else:
        print("indexed %d new chunks, %d already current (%d seen) into %s at %s"
              % (summary["chunks_new"], summary["chunks_unchanged"],
                 summary["chunks_seen"], summary["collection"], summary["url"]))
        print("seen by kind: %s" % format_counts(counts))
    return 0


def snippet(text: str, width: int = 320) -> str:
    flat = " ".join(text.split())
    return flat if len(flat) <= width else flat[: width - 1] + "…"


def command_search(args) -> int:
    instance = resolve_instance(args)
    client = Qdrant(instance)
    client.require_own_collection()
    embedder = Embedder(args.model)
    vector = embedder.encode([args.query])[0]
    hits = client.search(vector, args.k, args.kind)
    if args.json:
        result = {"query": args.query, "hits": [
            {"score": hit.get("score"), "payload": hit.get("payload")} for hit in hits
        ]}
        result.update(instance.fields())
        json.dump(result, sys.stdout, indent=2)
        sys.stdout.write("\n")
        return 0
    if not hits:
        print("no matches in %s at %s" % (instance.collection, instance.url))
        return 0
    print("%s at %s" % (instance.collection, instance.url))
    print("")
    for rank, hit in enumerate(hits, start=1):
        payload = hit.get("payload") or {}
        stamp = (payload.get("timestamp") or "")[:10] or "-"
        task = payload.get("task") or payload.get("session") or "-"
        print("%d. %.3f  %-10s %s  task=%s" % (
            rank, hit.get("score") or 0.0, payload.get("kind", "?"), stamp, task))
        print("   %s" % payload.get("source", "?"))
        print("   %s" % snippet(payload.get("text", "")))
        if rank != len(hits):
            print("")
    return 0


def command_identity(args) -> int:
    """Show which store this home resolves to, before anything is written."""
    instance = resolve_instance(args)
    if args.env:
        for assignment in instance.environment():
            print(assignment)
        return 0
    fields = instance.fields()
    if args.json:
        json.dump(fields, sys.stdout, indent=2)
        sys.stdout.write("\n")
        return 0
    width = max(len(key) for key in fields)
    for key, value in fields.items():
        print("%-*s  %s" % (width, key, value))
    return 0


def default_home() -> str:
    return os.environ.get("FM_HOME", str(Path(__file__).resolve().parents[1]))


def resolve_instance(args) -> Instance:
    """Resolve this run's instance: explicit flag, then environment, then home."""
    return Instance(
        home=args.home,
        url=args.url or os.environ.get("FM_CONTEXT_QDRANT_URL"),
        collection=args.collection or os.environ.get("FM_CONTEXT_COLLECTION"),
        transcripts=(getattr(args, "transcripts", None)
                     or os.environ.get("FM_CONTEXT_TRANSCRIPTS")),
        label=args.instance or os.environ.get("FM_CONTEXT_INSTANCE"),
    )


def add_home_argument(parser) -> None:
    parser.add_argument("--home", default=default_home(),
                        help="firstmate home this store belongs to "
                             "(default FM_HOME, else the repo root)")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="fm-context-index",
        description="Local semantic index over one firstmate home's context. "
                    "Collection, container, volume, port, and transcript glob "
                    "are all derived from that home, so two homes never share "
                    "a store by default.",
        epilog="Operator notes, privacy boundary, and setup: docs/context-index.md")
    parser.add_argument("--url", help="Qdrant base URL for this home's own "
                                      "instance (default: derived loopback port)")
    parser.add_argument("--collection", help="collection name "
                                             "(default: derived from the home)")
    parser.add_argument("--instance", help="instance label "
                                           "(default: derived from the home)")
    parser.add_argument("--model", default=os.environ.get(
        "FM_CONTEXT_MODEL", DEFAULT_MODEL),
        help="local sentence-transformers model (default %s)" % DEFAULT_MODEL)
    sub = parser.add_subparsers(dest="command")

    index = sub.add_parser("index", help="ingest this home's context incrementally")
    add_home_argument(index)
    index.add_argument("--transcripts",
                       help="glob for this home's Claude Code transcripts "
                            "(default: derived from the home)")
    index.add_argument("--kind", action="append", choices=KINDS,
                       help="restrict ingestion to a kind (repeatable)")
    index.add_argument("--dry-run", action="store_true",
                       help="print the planned chunks without embedding or writing")
    index.add_argument("--json", action="store_true", help="machine-readable output")
    index.set_defaults(func=command_index)

    search = sub.add_parser("search", help="semantic search with provenance")
    search.add_argument("query")
    add_home_argument(search)
    search.add_argument("--k", type=int, default=8, help="results to return (default 8)")
    search.add_argument("--kind", action="append", choices=KINDS,
                        help="restrict results to a kind (repeatable)")
    search.add_argument("--json", action="store_true", help="machine-readable output")
    search.set_defaults(func=command_search)

    identity = sub.add_parser(
        "identity", help="print the store identity this home resolves to")
    add_home_argument(identity)
    identity.add_argument("--json", action="store_true",
                          help="machine-readable output")
    identity.add_argument("--env", action="store_true",
                          help="print KEY=value assignments for the compose file")
    identity.set_defaults(func=command_identity)
    return parser


def main(argv) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    if not getattr(args, "func", None):
        parser.print_help()
        return 2
    try:
        return args.func(args)
    except ContextIndexError as error:
        sys.stderr.write("fm-context-index: %s\n" % error)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
